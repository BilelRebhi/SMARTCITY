# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.4
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

scriptDir="$(dirname "$0")"
scriptName="$(basename "$0")"

while IFS="=" read -r key value; do
  case "${key-}" in
  distributionUrl) distributionUrl=$(printf "%s" "${value-}" | tr -d '[:space:]') ;;
  esac
done <"$scriptDir/.mvn/wrapper/maven-wrapper.properties"
[ -n "${distributionUrl-}" ] || { echo "cannot read distributionUrl" >&2; exit 1; }

MVN_CMD="mvn${scriptName#mvnw}"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
distributionUrlNameMain="${distributionUrlNameMain%-bin}"
h=0; str="$distributionUrl"
while [ -n "$str" ]; do
  char="${str%"${str#?}"}"; h=$(((h*31+$(LC_CTYPE=C printf %d "'$char"))%4294967296)); str="${str#?}"
done
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${distributionUrlNameMain}/$(printf %x $h)"

if [ -d "$MAVEN_HOME" ]; then
  exec "$MAVEN_HOME/bin/$MVN_CMD" "$@"
fi

mkdir -p -- "${MAVEN_HOME%/*}"
TMP_DOWNLOAD_DIR="$(mktemp -d)"
trap 'rm -rf -- "$TMP_DOWNLOAD_DIR"' HUP INT TERM EXIT

if command -v wget >/dev/null; then
  wget --quiet "$distributionUrl" -O "$TMP_DOWNLOAD_DIR/$distributionUrlName"
elif command -v curl >/dev/null; then
  curl --silent -f -L -o "$TMP_DOWNLOAD_DIR/$distributionUrlName" "$distributionUrl"
fi

if command -v unzip >/dev/null; then
  unzip -q "$TMP_DOWNLOAD_DIR/$distributionUrlName" -d "$TMP_DOWNLOAD_DIR"
else
  tar xzf "$TMP_DOWNLOAD_DIR/$distributionUrlName" -C "$TMP_DOWNLOAD_DIR"
fi

mv -- "$TMP_DOWNLOAD_DIR/$distributionUrlNameMain" "$MAVEN_HOME"
exec "$MAVEN_HOME/bin/$MVN_CMD" "$@"
